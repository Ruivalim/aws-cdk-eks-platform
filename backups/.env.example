# DigitalOcean Spaces Configuration
BACKUP_S3_BUCKET=my-space-name
BACKUP_S3_PATH=backups
AWS_ACCESS_KEY_ID=DO00XXXXXXXXXX
AWS_SECRET_ACCESS_KEY=
AWS_REGION=nyc3

# DigitalOcean Spaces endpoint (change region as needed: nyc3, sfo3, ams3, sgp1, fra1)
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Volume backup schedule (default: 3am daily)
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=7

# PostgreSQL Backup Configuration
# Comma-separated list of postgres container names
POSTGRES_HOSTS=postgres,other-postgres
POSTGRES_DBS=all
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Postgres backup schedule (default: 3am daily)
POSTGRES_BACKUP_CRON=0 3 * * *
POSTGRES_BACKUP_RETENTION_DAYS=7
