# Digital Ocean API Token (obrigatorio)
# Obter em: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxx

# URLs de conexao Postgres (opcional, separadas por virgula)
# Usado para listar/criar databases na pagina Databases
POSTGRES_URLS=postgresql://user:password@host:5432/postgres

# ============ Cloudflare ============
# Obter em: https://dash.cloudflare.com/profile/api-tokens
# Permissoes necessarias: Zone:DNS:Edit, Account:Cloudflare Tunnel:Edit
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# ID da conta (visivel na URL do dashboard: dash.cloudflare.com/xxxxx)
CLOUDFLARE_ACCOUNT_ID=your_account_id

# ============ GitHub (para repos privados) ============
# Criar Personal Access Token: https://github.com/settings/tokens
# Permissoes: repo (full control) para repos privados
# Opcional: nao precisa se usar deploy keys por servidor
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ============ Gateway Server ============
# IP Tailscale do gateway server (Caddy)
# O gateway roteia trafego externo para os target servers via Tailscale
GATEWAY_SERVER_HOST=100.x.x.x

# ============ Build Server ============
# Nome SSH ou IP Tailscale do build server
BUILD_SERVER_HOST=build-server
# URL do registry Docker (IP Tailscale:porta)
REGISTRY_URL=100.x.x.x:5000

# ============ Timeouts (opcional) ============
BUILD_TIMEOUT=600000
HEALTH_CHECK_TIMEOUT=30000
