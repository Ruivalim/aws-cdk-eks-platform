# ============ Digital Ocean ============
# Obter em: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxx

# ============ Cloudflare ============
# Obter em: https://dash.cloudflare.com/profile/api-tokens
# Permissoes necessarias: Zone:DNS:Edit
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ============ GitHub ============
# Criar Personal Access Token: https://github.com/settings/tokens
# Permissoes: admin:public_key (para registrar SSH keys)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ============ Tailscale (opcional) ============
# Auth Key: Usado para setup automatico de servidores
# Obter em: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxx

# API Key: Usado para gerenciar devices (listar, remover)
# Obter em: https://login.tailscale.com/admin/settings/keys (API access token)
TAILSCALE_API_KEY=tskey-api-xxxxxxxx

# Tailnet: Nome da sua rede (ex: tail1234.ts.net ou your-org.github)
# Visivel em: https://login.tailscale.com/admin/machines
TAILSCALE_TAILNET=your-tailnet.ts.net
