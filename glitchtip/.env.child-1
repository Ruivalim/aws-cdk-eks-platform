# Glitchtip - Rodando em servidor child (doserver-child-1)
# Conecta no Postgres/Redis do doserver via Tailscale
#
# Diferença do .env normal:
# - POSTGRES_HOST e REDIS_HOST usam IP Tailscale (100.77.201.55)

# Postgres (doserver via Tailscale)
POSTGRES_HOST=100.77.201.55
POSTGRES_PORT=5432
POSTGRES_USER=glitchtip
POSTGRES_PASSWORD=GERAR_COM_setup-databases.ts
POSTGRES_DB=glitchtip

# Redis (doserver via Tailscale)
REDIS_HOST=100.77.201.55
REDIS_PORT=6379
REDIS_DB=1

# Secrets (gerar com: openssl rand -hex 32)
SECRET_KEY=GERAR_NOVO_SECRET

# App
GLITCHTIP_DOMAIN=https://errors.seudominio.com
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=noreply@seudominio.com
ENABLE_REGISTRATION=false
