# Hoppscotch - Rodando em servidor child (doserver-child-1)
# Conecta no Postgres do doserver via Tailscale
#
# Diferença do .env normal:
# - POSTGRES_HOST usa IP Tailscale (100.77.201.55)

# Postgres (doserver via Tailscale)
POSTGRES_HOST=100.77.201.55
POSTGRES_PORT=5432
POSTGRES_USER=hoppscotch
POSTGRES_PASSWORD=GERAR_COM_setup-databases.ts
POSTGRES_DB=hoppscotch

# Secrets (gerar com: openssl rand -hex 32)
JWT_SECRET=GERAR_NOVO_SECRET
SESSION_SECRET=GERAR_NOVO_SECRET

# URLs (ajustar para seu dominio)
APP_URL=https://api.seudominio.com
ADMIN_URL=https://api-admin.seudominio.com
BACKEND_URL=https://api-backend.seudominio.com
BACKEND_WS_URL=wss://api-backend.seudominio.com
