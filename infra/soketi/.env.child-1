# Soketi - Rodando em servidor child (doserver-child-1)
# Conecta no Redis do doserver via Tailscale para horizontal scaling
#
# Diferença do .env normal:
# - REDIS_HOST usa IP Tailscale (100.77.201.55)
#
# NOTA: Com Redis compartilhado, você pode ter múltiplas instâncias
# do Soketi em servidores diferentes e elas vão sincronizar automaticamente!

# Redis (doserver via Tailscale)
REDIS_HOST=100.77.201.55
REDIS_PORT=6379
REDIS_DB=2

# App credentials (devem ser iguais em todas as instâncias!)
SOKETI_APP_ID=app-id
SOKETI_APP_KEY=GERAR_SECRET_COMPARTILHADO
SOKETI_APP_SECRET=GERAR_SECRET_COMPARTILHADO

# Limites
SOKETI_MAX_CONNS=1000
SOKETI_MAX_EVENTS=1000

# Opcional
SOKETI_DEBUG=0
SOKETI_METRICS_ENABLED=false
