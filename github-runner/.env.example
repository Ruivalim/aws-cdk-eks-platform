# GitHub Runner Config
RUNNER_NAME=coolify-runner
RUNNER_SCOPE=repo

# Para repo específico:
RUNNER_REPOSITORY_URL=https://github.com/ruivalim/meu-projeto

# Ou para organização inteira:
# RUNNER_SCOPE=org
# RUNNER_ORGANIZATION_URL=https://github.com/minha-org

# Personal Access Token (repo scope ou admin:org pra org)
GITHUB_ACCESS_TOKEN=ghp_xxxxxxxxxxxxx

# Labels customizados
RUNNER_LABELS=self-hosted,coolify,docker

# Runner efêmero (recria após cada job)
RUNNER_EPHEMERAL=false
